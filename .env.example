# Referencia de variables. En la máquina de JP NO se usa un .env por proyecto:
#   - secrets  → ~/setup/.env-collection/master.env (fuera de git), cargado por direnv (.envrc)
#   - config   → .env.defaults (versionado)
# Para otra máquina sin direnv: copia esto a .env y completa.

# --- secrets ---
OPENROUTER_API_KEY=          # LLM del tutor (TUTOR_MODEL=openrouter:...)
TYPESAFE_API_KEY=            # Jev: ruteo de contexto (TUTOR_SELECTOR=auto|jev)
# OPENAI_API_KEY=            # si TUTOR_MODEL=openai:...
# GEMINI_API_KEY=            # si TUTOR_MODEL=google:...
TUTOR_MCP_TOKEN=             # Bearer del MCP por HTTP; vacío = sin auth (solo local)

# --- config (ver .env.defaults) ---
TUTOR_MODEL=openrouter:deepseek/deepseek-v4.1-flash   # "test" = sin red; ver .env.defaults
TUTOR_SELECTOR=auto          # heuristic | jev | auto
TUTOR_MAX_TOKENS=1500        # tope de salida por turno (OpenRouter lo cobra contra el crédito)
TUTOR_EMBEDDER=hash          # hash (sin red) | fastembed (extra `embed`, regenerar KB)
TUTOR_KB=kbs/apos
