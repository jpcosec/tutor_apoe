# Copia a .env y completa. Nada de esto se versiona.

# Token que debe presentar el cliente MCP (Authorization: Bearer ...). Vacío = sin auth (solo local).
TUTOR_MCP_TOKEN=

# Modelo del tutor para run_turn. "test" no usa red. Ejemplos:
#   openai:gpt-4o-mini   google:gemini-2.5-flash   openrouter:anthropic/claude-sonnet-4
TUTOR_MODEL=test
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Embeddings: hash (sin red, determinista) o fastembed (requiere extra `embed` y descarga de modelo).
TUTOR_EMBEDDER=hash

# Ruteo de contexto con Jev (TypeSafe). Opcional; sin key se usa la heurística.
# TYPESAFE_API_KEY=
