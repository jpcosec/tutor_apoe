# Config NO secreta del proyecto (se versiona). Los secrets vienen del .env central vía direnv.
# Cualquier valor se puede pisar exportando la variable antes.

# LLM del tutor: OpenRouter (requiere OPENROUTER_API_KEY). "test" = sin red.
TUTOR_MODEL=openrouter:google/gemini-2.5-flash

# Ruteo de contexto: auto = Jev (TypeSafe) si hay TYPESAFE_API_KEY, si no heurística.
TUTOR_SELECTOR=auto

# Tope de tokens de salida por turno (OpenRouter los reserva contra el crédito disponible).
TUTOR_MAX_TOKENS=1500

# Embeddings: hash (sin red). fastembed requiere el extra `embed` y regenerar la KB.
TUTOR_EMBEDDER=hash

# KB por defecto para el CLI y la web.
TUTOR_KB=kbs/apos
